# Bit-exact unit gates.  Every ported module gets one; vectors come from
# WSJT-X itself (tests/vectors/, generated by tools/vectors/).
test_hash = executable('test_hash', 'test_hash.c', dependencies : ftx_dep)
test('hash (ihashcall 10/12/22 vectors)', test_hash)

test_crc14 = executable('test_crc14', 'test_crc14.c', dependencies : ftx_dep)
test('crc14 (WSJT-X crc14.cpp vectors)', test_crc14,
     args : [files('vectors/crc14_vectors.txt')])

pack77_vectors = files(
  'vectors/pack77/messages_txt.vec',
  'vectors/pack77/ft8_testmsg.vec',
  'vectors/pack77/ft4.vec',
  'vectors/pack77/edge.vec',
  'vectors/pack77/mycall.vec',
  'vectors/pack77/hashfill.vec',
  'vectors/pack77/random.vec',
)
test_pack77 = executable('test_pack77', 'test_pack77.c', dependencies : ftx_dep)
test('pack77 (WSJT-X packjt77 vectors)', test_pack77, args : pack77_vectors)
